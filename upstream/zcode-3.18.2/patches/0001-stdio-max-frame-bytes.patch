+++ b/packages/desktop/test/zcodeStdioTransportFrameLimit.node.test.ts
@@ -0,0 +1,225 @@
+// ZCode stdio 帧上限属于进程协议的防资源耗尽边界，不恢复已退役的 App 业务单测。
+// 使用仓库已有的 node:test + tsx 入口，以原始 stdout 字节验证 framing 行为。
+import assert from "node:assert/strict";
+import type { ChildProcessWithoutNullStreams } from "node:child_process";
+import { EventEmitter, once } from "node:events";
+import { PassThrough } from "node:stream";
+import { test } from "node:test";
+import type { ZCodeProtocolTransportClosedEvent } from "../../services/src/zcode-agent/zcodeProtocolTransport.js";
+import { ZCodeProtocolClient } from "../../services/src/zcode-agent/zcodeProtocolClient.js";
+import { ZCodeStdioTransport } from "../../services/src/zcode-agent/zcodeStdioTransport.js";
+
+const MIB_16 = 16 * 1024 * 1024;
+
+function createHarness(maxFrameBytes?: number) {
+  const stdin = new PassThrough();
+  const stdout = new PassThrough();
+  const stderr = new PassThrough();
+  const child = new EventEmitter() as ChildProcessWithoutNullStreams;
+  Object.assign(child, {
+    stdin,
+    stdout,
+    stderr,
+    exitCode: null,
+    killed: false,
+    pid: 42,
+    signalCode: null,
+  });
+  const transport = new ZCodeStdioTransport(child, { maxFrameBytes });
+  const messages: unknown[] = [];
+  const closes: ZCodeProtocolTransportClosedEvent[] = [];
+  transport.onMessage((message) => messages.push(message));
+  transport.onClose((event) => closes.push(event));
+  return { closes, messages, stderr, stdout, transport };
+}
+
+function frameWithPadding(byteLength: number): string {
+  const json = JSON.stringify({ id: 1, result: "ok" });
+  const paddingBytes = byteLength - Buffer.byteLength(json, "utf8");
+  assert.ok(paddingBytes >= 0);
+  return `${json}${" ".repeat(paddingBytes)}`;
+}
+
+function pendingByteCount(transport: ZCodeStdioTransport): number {
+  return (transport as unknown as { stdoutPendingBytes: number }).stdoutPendingBytes;
+}
+
+function pendingChunkCount(transport: ZCodeStdioTransport): number {
+  return (transport as unknown as { stdoutPendingChunks: Buffer[] }).stdoutPendingChunks.length;
+}
+
+function finish(streams: PassThrough[]): void {
+  for (const stream of streams) stream.end();
+}
+
+async function finishStdout(stdout: PassThrough, trailing?: string | Buffer): Promise<void> {
+  const ended = once(stdout, "end");
+  stdout.end(trailing);
+  await ended;
+}
+
+test("accepts an exact 16 MiB frame with whitespace padding and rejects +1 byte", () => {
+  const exact = createHarness(MIB_16);
+  try {
+    exact.stdout.write(`${frameWithPadding(MIB_16)}\n`);
+    assert.deepEqual(exact.messages, [{ id: 1, result: "ok" }]);
+    assert.deepEqual(exact.closes, []);
+    assert.equal(pendingByteCount(exact.transport), 0);
+  } finally {
+    finish([exact.stdout, exact.stderr]);
+  }
+
+  const overflow = createHarness(MIB_16);
+  try {
+    overflow.stdout.write(`${frameWithPadding(MIB_16)} \n`);
+    assert.deepEqual(overflow.messages, []);
+    assert.equal(overflow.closes.length, 1);
+    assert.match(overflow.closes[0]!.reason ?? "", /stdout_frame_too_large/);
+    assert.equal(pendingByteCount(overflow.transport), 0);
+  } finally {
+    finish([overflow.stdout, overflow.stderr]);
+  }
+});
+
+test("fails immediately for an oversized partial frame and clears the buffer", () => {
+  const harness = createHarness(MIB_16);
+  try {
+    harness.stdout.write(Buffer.alloc(MIB_16, 0x20));
+    assert.deepEqual(harness.closes, []);
+    assert.equal(pendingByteCount(harness.transport), MIB_16);
+
+    harness.stdout.write(" ");
+    assert.equal(harness.closes.length, 1);
+    assert.match(harness.closes[0]!.reason ?? "", /stdout_frame_too_large/);
+    assert.equal(pendingByteCount(harness.transport), 0);
+    assert.equal(pendingChunkCount(harness.transport), 0);
+
+    harness.stdout.write('{"id":2,"result":"ignored"}\n');
+    harness.stdout.end();
+    assert.deepEqual(harness.messages, []);
+    assert.equal(harness.closes.length, 1);
+  } finally {
+    finish([harness.stderr]);
+  }
+});
+
+test("counts raw UTF-8 bytes across chunk boundaries without splitting multibyte text", () => {
+  const json = JSON.stringify({ id: 1, result: "中" });
+  const bytes = Buffer.from(`${json}\n`, "utf8");
+  const charOffset = bytes.indexOf(Buffer.from("中", "utf8"));
+  assert.ok(charOffset > 0);
+  const harness = createHarness(Buffer.byteLength(json, "utf8"));
+  try {
+    harness.stdout.write(bytes.subarray(0, charOffset + 1));
+    harness.stdout.write(bytes.subarray(charOffset + 1, charOffset + 2));
+    harness.stdout.write(bytes.subarray(charOffset + 2));
+    assert.deepEqual(harness.messages, [{ id: 1, result: "中" }]);
+    assert.deepEqual(harness.closes, []);
+  } finally {
+    finish([harness.stdout, harness.stderr]);
+  }
+});
+
+test("excludes LF from the byte budget and includes CR", () => {
+  const json = JSON.stringify({ id: 1, result: "ok" });
+  const jsonBytes = Buffer.byteLength(json, "utf8");
+  const lf = createHarness(jsonBytes);
+  try {
+    lf.stdout.write(`${json}\n`);
+    assert.deepEqual(lf.messages, [{ id: 1, result: "ok" }]);
+    assert.deepEqual(lf.closes, []);
+  } finally {
+    finish([lf.stdout, lf.stderr]);
+  }
+
+  const crlfWithinLimit = createHarness(jsonBytes + 1);
+  try {
+    crlfWithinLimit.stdout.write(`${json}\r\n`);
+    assert.deepEqual(crlfWithinLimit.messages, [{ id: 1, result: "ok" }]);
+    assert.deepEqual(crlfWithinLimit.closes, []);
+  } finally {
+    finish([crlfWithinLimit.stdout, crlfWithinLimit.stderr]);
+  }
+
+  const crOverflow = createHarness(jsonBytes);
+  try {
+    crOverflow.stdout.write(`${json}\r\n`);
+    assert.deepEqual(crOverflow.messages, []);
+    assert.equal(crOverflow.closes.length, 1);
+    assert.match(crOverflow.closes[0]!.reason ?? "", /stdout_frame_too_large/);
+  } finally {
+    finish([crOverflow.stdout, crOverflow.stderr]);
+  }
+});
+
+test("fails closed on a partial frame at EOF", async () => {
+  const harness = createHarness(128);
+  try {
+    await finishStdout(harness.stdout, JSON.stringify({ id: 1, result: "unterminated" }));
+    assert.deepEqual(harness.messages, []);
+    assert.equal(harness.closes.length, 1);
+    assert.equal(harness.closes[0]!.reason, "stdout_partial_frame");
+    assert.equal(pendingByteCount(harness.transport), 0);
+    assert.equal(pendingChunkCount(harness.transport), 0);
+  } finally {
+    finish([harness.stderr]);
+  }
+});
+
+test("dispatches multiple LF/CRLF frames and closes normally at EOF", async () => {
+  const harness = createHarness(128);
+  try {
+    harness.stdout.write(
+      [
+        JSON.stringify({ id: 1, result: "one" }),
+        JSON.stringify({ id: 2, result: "two" }),
+        JSON.stringify({ id: 3, result: "three" }),
+        "",
+      ].join("\n").replace("\n", "\r\n"),
+    );
+    assert.deepEqual(harness.messages, [
+      { id: 1, result: "one" },
+      { id: 2, result: "two" },
+      { id: 3, result: "three" },
+    ]);
+    assert.deepEqual(harness.closes, []);
+
+    await finishStdout(harness.stdout);
+    assert.deepEqual(harness.closes, [{ reason: "stdout_closed" }]);
+    assert.equal(pendingByteCount(harness.transport), 0);
+  } finally {
+    finish([harness.stderr]);
+  }
+});
+
+test("rejects every pending RPC and emits close exactly once on frame overflow", async () => {
+  const harness = createHarness(64);
+  const client = new ZCodeProtocolClient(harness.transport);
+  let closeCount = 0;
+  client.onClose(() => {
+    closeCount += 1;
+  });
+  const requests = [
+    client.request("runtime/capabilities"),
+    client.request("runtime/capabilities"),
+    client.request("runtime/capabilities"),
+  ];
+  try {
+    harness.stdout.write(Buffer.alloc(65, 0x20));
+    const settled = await Promise.allSettled(requests);
+    assert.equal(settled.length, 3);
+    for (const result of settled) {
+      assert.equal(result.status, "rejected");
+      assert.match(String(result.reason), /ZCode agent transport closed: stdout_frame_too_large/);
+    }
+    assert.equal(client.pendingRequestCount, 0);
+    assert.equal(closeCount, 1);
+
+    harness.stdout.write(`${JSON.stringify({ id: 9, result: "ignored" })}\n`);
+    harness.stdout.end();
+    assert.equal(closeCount, 1);
+    assert.equal(pendingByteCount(harness.transport), 0);
+  } finally {
+    finish([harness.stderr]);
+  }
+});
