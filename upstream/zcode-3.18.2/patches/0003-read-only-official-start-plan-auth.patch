+  const provider = input.activeProvider;
+  const values: Record<string, string> = {
+    "oauth:active_provider": provider,
+    "oauth:session_revision": input.sessionRevision ?? "revision-1",
+    [`oauth:${provider}:access_token`]: `access-token-${input.account}`,
+    [`oauth:${provider}:refresh_token`]: `refresh-token-${input.account}`,
+    [`oauth:${provider}:user_info`]: JSON.stringify(provider === "bigmodel"
+      ? {
+          id: input.account,
+          username: input.account,
+          displayName: input.account,
+          rawProfile: { user_id: input.account },
+        }
+      : {
+          user_id: input.account,
+          name: input.account,
+          email: `${input.account}@example.invalid`,
+        }),
+    zcodejwttoken: input.jwt ?? syntheticJwt(Date.now() + 120_000),
+  };
+  if (input.linkedBigModel !== undefined) {
+    values["oauth:linked_bigmodel"] = JSON.stringify(input.linkedBigModel);
+  }
+  return values;
