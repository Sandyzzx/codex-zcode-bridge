+class FakeKeyStore implements CredentialKeyStore {
+  readonly #value: string | null;
+  setCalls = 0;
+
+  constructor(value: string | null) {
+    this.#value = value;
+  }
+
+  async get(): Promise<string | null> {
+    return this.#value;
+  }
+
+  async set(): Promise<void> {
+    this.setCalls += 1;
