+ * official requests, while a read path must never mint a replacement.
+ */
+export async function readTelemetryDeviceMid(
+  options: ReadTelemetryDeviceMidOptions = {},
+): Promise<string | null> {
+  const state = await readTelemetryState(options.homeDir);
+  return typeof state.deviceMid === "string" && state.deviceMid.trim()
+    ? state.deviceMid.trim()
+    : null;
+}
