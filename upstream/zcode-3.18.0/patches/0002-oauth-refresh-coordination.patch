+import { fork, type ChildProcess } from "node:child_process";
+import { mkdir, mkdtemp, rm } from "node:fs/promises";
+import { createServer, type Server } from "node:http";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { afterEach, expect, it } from "vitest";
+import { createSystemCredentialCipher } from "@zcode/shared/credential-security";
+import { createCredentialService } from "../src/credential/credentialService.js";
+import { setDataBaseDir } from "../src/paths.js";
+
+const TEST_TMP_ROOT = fileURLToPath(new URL("./.tmp", import.meta.url));
+const CHILD_DRIVER = new URL("./fixtures/oauth-refresh-coordination-child.ts", import.meta.url);
+const REPO_ROOT = fileURLToPath(new URL("../../../", import.meta.url));
+const TEST_SECRET = "oauth-refresh-coordination-test-secret";
+const NETWORK_TIMEOUT_MS = 5_000;
+
+const children = new Set<ChildProcess>();
+const servers = new Set<Server>();
+
+afterEach(async () => {
+  await Promise.all([...children].map((child) => killChild(child)));
+  children.clear();
+  await Promise.all(
+    [...servers].map(
+      (server) =>
+        new Promise<void>((resolve) => {
+          server.close(() => resolve());
+        }),
+    ),
+  );
+  servers.clear();
+  await rm(TEST_TMP_ROOT, { force: true, recursive: true });
+});
+
+interface ChildResult {
+  accessToken: string;
+  events: string[];
+  refreshToken: string;
+  revision: string;
+}
+
+interface ChildConfig {
+  dataBaseDir: string;
+  mode: "refresh" | "hold-lock";
+  refreshLockMaxWaitMs?: number;
+  refreshNetworkTimeoutMs?: number;
+  refreshUrl: string;
+}
+
+interface ChildError {
+  code?: string;
+  message: string;
+  type: "error";
+}
+
+type ChildMessage =
+  | ChildError
+  | { type: "lock-acquired" }
+  | { type: "lock-held" }
+  | { type: "ready" }
+  | { result: ChildResult; type: "result" }
+  | { type: "waiting" };
+
+class ChildHarness {
+  private readonly messages: ChildMessage[] = [];
+  private cursor = 0;
+  private waiters = new Set<() => void>();
+  private stdout = "";
+  private stderr = "";
+  private exited = false;
+  private spawnError: Error | null = null;
+  private exitDescription = "";
+
+  constructor(readonly child: ChildProcess) {
+    child.stdout?.on("data", (chunk: Buffer) => {
+      this.stdout += chunk.toString("utf8");
+    });
+    child.stderr?.on("data", (chunk: Buffer) => {
+      this.stderr += chunk.toString("utf8");
+    });
+    child.once("error", (error) => {
+      this.spawnError = error;
+      this.exited = true;
+      for (const wake of this.waiters) wake();
+    });
+    child.on("message", (message: ChildMessage) => {
+      this.messages.push(message);
+      for (const wake of this.waiters) wake();
+    });
+    child.once("exit", (code, signal) => {
+      this.exited = true;
+      this.exitDescription = `code=${String(code)}, signal=${String(signal)}`;
+      for (const wake of this.waiters) wake();
+    });
+  }
+
+  async start(): Promise<void> {
+    await this.next("ready");
+  }
+
+  async next<T extends ChildMessage["type"]>(type: T): Promise<Extract<ChildMessage, { type: T }>> {
+    const deadline = Date.now() + 20_000;
+    while (true) {
+      while (this.cursor < this.messages.length) {
+        const message = this.messages[this.cursor++]!;
+        if (message.type === "error" && type !== "error") {
+          throw new Error(
+            `child failed with ${message.code ?? "no code"}: ${message.message}; stderr: ${this.stderr}`,
+          );
+        }
+        if (message.type === type) {
+          return message as Extract<ChildMessage, { type: T }>;
+        }
+      }
+      if (this.exited) {
+        throw new Error(
+          `child exited before ${type}; messages: ${JSON.stringify(this.messages)}; stdout: ${this.stdout}; stderr: ${this.stderr}; error: ${this.spawnError?.message ?? "none"}; ${this.exitDescription}`,
+        );
+      }
+      const remaining = deadline - Date.now();
+      if (remaining <= 0) {
+        throw new Error(`timed out waiting for child ${type}; stderr: ${this.stderr}`);
+      }
+      await new Promise<void>((resolve) => {
+        const timer = setTimeout(
+          () => {
+            this.waiters.delete(wake);
+            resolve();
+          },
+          Math.min(remaining, 250),
+        );
+        const wake = () => {
+          clearTimeout(timer);
+          this.waiters.delete(wake);
+          resolve();
+        };
+        this.waiters.add(wake);
+      });
+    }
+  }
+}
+
+interface SyntheticRequest {
+  accessToken: string;
+  refreshToken: string;
+}
+
+class SyntheticRefreshServer {
+  readonly requests: SyntheticRequest[] = [];
+  private readonly consumedRefreshTokens = new Set<string>();
+  private readonly heldResponses: Array<{
+    payload: Record<string, string>;
+    response: import("node:http").ServerResponse;
+  }> = [];
+  private readonly requestWaiters = new Set<() => void>();
+  private failureNext = false;
+  private holdResponses = false;
+  private requestCount = 0;
+  private readonly server: Server;
+  readonly url!: string;
+
+  constructor(private readonly responseDelayMs = 0) {
+    this.server = createServer((request, response) => {
+      void this.handle(request, response);
+    });
+  }
+
+  async start(): Promise<void> {
+    servers.add(this.server);
+    await new Promise<void>((resolve) => this.server.listen(0, "127.0.0.1", resolve));
+    const address = this.server.address();
+    if (!address || typeof address === "string") throw new Error("synthetic server did not bind");
+    this.url = `http://127.0.0.1:${address.port}/refresh`;
+  }
+
+  failNext(): void {
+    this.failureNext = true;
+  }
+
+  holdNextResponses(): void {
+    this.holdResponses = true;
+  }
+
+  releaseHeldResponses(): void {
+    for (const held of this.heldResponses.splice(0)) {
+      held.response.writeHead(200, { "content-type": "application/json" });
+      held.response.end(JSON.stringify(held.payload));
+    }
+  }
+
+  async waitForRequests(count: number): Promise<void> {
+    const deadline = Date.now() + 10_000;
+    while (this.requests.length < count) {
+      if (Date.now() >= deadline) {
+        throw new Error(`timed out waiting for ${count} refresh requests`);
+      }
+      await new Promise<void>((resolve) => {
+        const wake = () => {
+          clearTimeout(timer);
+          this.requestWaiters.delete(wake);
+          resolve();
+        };
+        const timer = setTimeout(() => {
+          this.requestWaiters.delete(wake);
+          resolve();
+        }, 100);
+        this.requestWaiters.add(wake);
+      });
+    }
+  }
+
+  private async handle(
+    request: import("node:http").IncomingMessage,
+    response: import("node:http").ServerResponse,
+  ): Promise<void> {
+    let raw = "";
+    for await (const chunk of request) raw += chunk.toString();
+    const body = JSON.parse(raw) as SyntheticRequest;
+    this.requests.push(body);
+    for (const wake of this.requestWaiters) wake();
+
+    if (this.failureNext) {
+      this.failureNext = false;
+      response.writeHead(503, { "content-type": "application/json" });
+      response.end(JSON.stringify({ error: "synthetic refresh unavailable" }));
+      return;
+    }
+    if (this.consumedRefreshTokens.has(body.refreshToken)) {
+      response.writeHead(400, { "content-type": "application/json" });
+      response.end(JSON.stringify({ error: "invalid_grant" }));
+      return;
+    }
+
+    this.consumedRefreshTokens.add(body.refreshToken);
+    this.requestCount += 1;
+    const payload = {
+      accessToken: `rotated-access-${this.requestCount}`,
+      refreshToken: `rotated-refresh-${this.requestCount}`,
+    };
+    if (this.holdResponses) {
+      this.heldResponses.push({ payload, response });
+      return;
+    }
+    await new Promise((resolve) => setTimeout(resolve, this.responseDelayMs));
+    response.writeHead(200, { "content-type": "application/json" });
+    response.end(JSON.stringify(payload));
+  }
+}
+
+async function createSignedInProfile(input: {
+  baseDirName: string;
+  refreshToken?: string;
+  userId?: string;
+}): Promise<{
+  dataBaseDir: string;
+  credentialService: ReturnType<typeof createCredentialService>;
+}> {
+  await mkdir(TEST_TMP_ROOT, { recursive: true });
+  const dataBaseDir = await mkdtemp(join(TEST_TMP_ROOT, `${input.baseDirName}-`));
+  setDataBaseDir(dataBaseDir);
+  const credentialsFilePath = join(dataBaseDir, ".zcode", "v2", "credentials.json");
+  const credentialService = createCredentialService({
+    cipherProvider: createSystemCredentialCipher({
+      env: { ZCODE_CREDENTIAL_SECRET: TEST_SECRET },
+      filePath: credentialsFilePath,
+    }),
+  });
+  const userId = input.userId ?? "alice";
+  await credentialService.updateMany({
+    "oauth:active_provider": "zai",
+    "oauth:session_revision": `revision-${userId}-seed`,
+    "oauth:zai:access_token": `access-${userId}-seed`,
+    "oauth:zai:refresh_token": input.refreshToken ?? `refresh-${userId}-seed`,
+    "oauth:zai:user_info": JSON.stringify({
+      id: userId,
+      username: userId,
+      displayName: userId,
+    }),
+    zcodejwttoken: `jwt-${userId}`,
+  });
+  return { credentialService, dataBaseDir };
+}
+
+function spawnChild(config: ChildConfig): ChildHarness {
+  const child = fork(CHILD_DRIVER, [JSON.stringify(config)], {
+    cwd: REPO_ROOT,
+    env: { ...process.env, NODE_NO_WARNINGS: "1" },
+    execArgv: ["--import", "tsx"],
+    stdio: ["ignore", "ignore", "pipe", "ipc"],
+  });
+  children.add(child);
+  child.once("exit", () => children.delete(child));
+  return new ChildHarness(child);
+}
+
+async function killChild(child: ChildProcess): Promise<void> {
+  if (child.exitCode !== null || child.signalCode !== null) return;
+  await new Promise<void>((resolve) => {
+    const timer = setTimeout(resolve, 2_000);
+    child.once("exit", () => {
+      clearTimeout(timer);
+      resolve();
+    });
+    child.kill("SIGKILL");
+  });
+}
