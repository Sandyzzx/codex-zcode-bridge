+import type { CredentialKeyStore } from "@zcode/shared/credential-security";
+import { createCredentialService } from "../../src/credential/credentialService.js";
+import { createOfficialStartPlanAuthenticationResolver } from "../../src/official-host/startPlanAuthentication.js";
+
+const [dataBaseDir, mode] = process.argv.slice(2);
+if (!dataBaseDir || !mode) throw new Error("dataBaseDir and mode are required");
+
+const encodedKey = process.env.ZCODE_TEST_READ_ONLY_KEY;
+const keyStore: CredentialKeyStore | undefined = mode === "os"
+  ? {
+      get: async () => encodedKey ?? null,
+      set: async () => {
+        throw new Error("cold-process read-only key store must not be written");
+      },
+    }
+  : undefined;
+
+const resolver = createOfficialStartPlanAuthenticationResolver({
+  dataBaseDir,
+  ...(mode === "os"
+    ? {
+        createReadOnlyCredentialService: () => createCredentialService({
+          readOnly: true,
+          env: {},
+          keyStore,
+        }),
+      }
+    : {}),
+});
+
+const result = await resolver.resolveStartPlanAuthentication({
+  family: "bigmodel",
+  signal: new AbortController().signal,
+});
+process.stdout.write(JSON.stringify({ result }));
