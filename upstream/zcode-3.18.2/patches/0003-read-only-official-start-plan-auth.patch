+    inspectStore: async () => ({ status: "healthy" }),
+    recoverStore: async () => ({ status: "changed" }),
+    load: async (key) => values[key] ?? null,
+    loadMany: async (keys) => Object.fromEntries(keys.map((key) => [key, values[key] ?? null])),
+    save: async () => undefined,
+    delete: async () => undefined,
+    updateMany: async () => false,
+    deleteUnreadable: async () => false,
+    recoverUnreadable: async () => null,
