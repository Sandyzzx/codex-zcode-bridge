+import { join } from "node:path";
+import type { ApiClient, OAuthProviderAdapter, OAuthTokenSet } from "@zcode/shared";
+import { createSystemCredentialCipher } from "@zcode/shared/credential-security";
+import { createCredentialService } from "../../src/credential/credentialService.js";
+import { OAuthService } from "../../src/oauth/oauthService.js";
+import { setDataBaseDir } from "../../src/paths.js";
+
+interface ChildConfig {
+  dataBaseDir: string;
+  mode: "refresh" | "hold-lock";
+  refreshLockMaxWaitMs?: number;
+  refreshNetworkTimeoutMs?: number;
+  refreshUrl: string;
+}
+
+const config = JSON.parse(process.argv[2] ?? "null") as ChildConfig | null;
+process.send?.({ type: "ready" });
+if (!config) {
+  process.send?.({ message: "invalid child input", type: "error" });
+} else {
+  void run(config);
+}
+
+async function run(config: ChildConfig): Promise<void> {
+  try {
+    setDataBaseDir(config.dataBaseDir);
+    const credentialsFilePath = join(config.dataBaseDir, ".zcode", "v2", "credentials.json");
+    const credentialService = createCredentialService({
+      cipherProvider: createSystemCredentialCipher({
+        env: { ZCODE_CREDENTIAL_SECRET: "oauth-refresh-coordination-test-secret" },
+        filePath: credentialsFilePath,
+      }),
+    });
+    const adapter: OAuthProviderAdapter = {
+      providerId: "zai",
+      meta: { id: "zai", displayName: "Synthetic", enabled: true, order: 0 },
+      redirectUri: "http://127.0.0.1/callback",
+      apiClient: {} as ApiClient,
+      parseCallbackParams: () => ({ code: "", state: "" }),
+      buildAuthorizeUrl: () => "http://127.0.0.1/authorize",
+      exchangeToken: async () => ({ accessToken: "" }),
+      normalizeError: (error) => (error instanceof Error ? error : new Error(String(error))),
+      refreshToken: async (tokenSet, context) => {
+        const response = await fetch(config.refreshUrl, {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({
+            accessToken: tokenSet.accessToken,
+            refreshToken: tokenSet.refreshToken,
+          }),
+          signal: context.signal,
+        });
+        const payload = (await response.json()) as {
+          accessToken?: unknown;
+          error?: unknown;
+          refreshToken?: unknown;
+        };
+        if (!response.ok) {
+          throw new Error(
+            typeof payload.error === "string"
+              ? payload.error
+              : `refresh failed: ${response.status}`,
+          );
+        }
+        if (typeof payload.accessToken !== "string" || typeof payload.refreshToken !== "string") {
+          throw new Error("synthetic provider returned an invalid token set");
+        }
+        return payload as OAuthTokenSet;
+      },
+    };
+    const events: string[] = [];
+    const service = new OAuthService(credentialService, {
+      adapters: [adapter],
+      onRefreshWaitStarted: () => process.send?.({ type: "waiting" }),
+      onRefreshLockAcquired: async () => {
+        process.send?.({ type: "lock-acquired" });
+        if (config.mode === "hold-lock") {
+          process.send?.({ type: "lock-held" });
+          await new Promise(() => {
+            setInterval(() => undefined, 1_000);
+          });
+        }
+      },
+      refreshLockOptions:
+        config.refreshLockMaxWaitMs === undefined
+          ? undefined
+          : {
+              lockMaxWaitMs: config.refreshLockMaxWaitMs,
+              lockOwnerlessGraceMs: 25,
+              lockRetryDelaysMs: [20],
+            },
+      refreshNetworkTimeoutMs: config.refreshNetworkTimeoutMs,
+    });
+    service.onDidChangeSession((state) => events.push(state));
+    await service.refreshToken("zai");
+    const values = await credentialService.loadMany([
+      "oauth:active_provider",
+      "oauth:session_revision",
+      "oauth:zai:access_token",
+      "oauth:zai:refresh_token",
+      "oauth:zai:user_info",
+      "zcodejwttoken",
+    ]);
+    sendFinal({
+      type: "result",
+      result: {
+        accessToken: values["oauth:zai:access_token"],
+        events,
+        refreshToken: values["oauth:zai:refresh_token"],
+        revision: values["oauth:session_revision"],
+      },
+    });
+  } catch (error) {
+    sendFinal({
+      type: "error",
+      code:
+        typeof error === "object" && error !== null && "code" in error
+          ? String((error as { code?: unknown }).code ?? "")
+          : undefined,
+      message: error instanceof Error ? error.message : String(error),
+    });
+  }
+}
+
+function sendFinal(message: unknown): void {
+  process.send?.(message);
+}
