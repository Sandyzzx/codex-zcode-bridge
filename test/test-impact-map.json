{
  "schema_version": 1,
  "notes": [
    "Paths are repository-relative and use POSIX separators.",
    "Runtime is unknown unless an entry cites a repository report; missing runtime is NOT RUN, not fast.",
    "Stress classification is explicit. Tests are not inferred to be stress solely from names or long timeouts."
  ],
  "domains": [
    {
      "id": "ci-release-contract",
      "description": "CI, release packaging, generated bundle identity, and top-level build configuration.",
      "paths": [
        ".github/workflows/**",
        "package.json",
        "package-lock.json",
        "tsconfig.json",
        "tsconfig.test.json",
        "release-please-config.json",
        ".release-please-manifest.json",
        "plugins/codex-zcode-bridge/dist/**",
        "plugins/codex-zcode-bridge/worker/**",
        "scripts/build-core.mjs",
        "scripts/build-plugin.mjs",
        "scripts/validate-plugin.mjs"
      ]
    },
    {
      "id": "test-execution-contract",
      "description": "Test runner, selector, test TypeScript configuration, shared fixtures, and mapping data.",
      "paths": [
        "scripts/test-isolated.mjs",
        "scripts/test-clean-entrypoints.mjs",
        "scripts/test-impact-selector.mjs",
        "scripts/lib/test-files.mjs",
        "scripts/run-affected-tests.mjs",
        "scripts/run-stress-tests.mjs",
        "test/test-impact-map.json",
        "test/helpers.ts",
        "test/runtime-fixture.ts",
        "test/runtime/bootstrap-lock-worker.mjs",
        "test/sqlite-candidate/wp6b2b1/lifecycle-process.mjs",
        "test/sqlite-candidate/wp6b2b1/worker-process.mjs",
        "scripts/select-sqlite-stress.mjs"
      ]
    },
    {
      "id": "interface-contract",
      "description": "Public MCP/interface types and schemas shared by Manager, Worker, and Host.",
      "paths": [
        "src/interfaces.ts",
        "src/mcp/schemas.ts",
        "src/result-contract.mjs"
      ]
    },
    {
      "id": "provider-catalog",
      "description": "Provider/account catalog, model selection, session preferences, and Doctor preference checks.",
      "paths": [
        "src/runtime/account-provider.ts",
        "src/runtime/model-routing.ts",
        "src/runtime/model-settings.ts",
        "src/runtime/session-preferences.ts",
        "src/runtime/start-plan-production-auth.ts"
      ]
    },
    {
      "id": "zcode-path-discovery",
      "description": "ZCode installation/user-data discovery, Runtime Resolver, child environment portability, and path Doctor.",
      "paths": [
        "src/runtime/paths.ts",
        "src/runtime/resolver.ts",
        "src/runtime/child-env.ts",
        "src/runtime/desktop-host-launch.ts",
        "src/runtime/doctor.ts",
        "src/runtime/node-runtime.ts"
      ]
    },
    {
      "id": "workspace-provider",
      "description": "Direct and Git worktree workspace provisioning.",
      "paths": [
        "src/workspace/direct-provider.ts"
      ]
    },
    {
      "id": "task-prompt-and-report",
      "description": "Task prompt construction and Agent Report extraction/normalization.",
