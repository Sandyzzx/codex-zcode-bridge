index 0000000000000000000000000000000000000000..dd59e6915b795570c81dfad2c06cd7071c45dbb7
--- /dev/null
+++ b/packages/services/src/official-host/costLabBillingRuntime.ts
@@ -0,0 +1,236 @@
+import type {
+  ApiClient,
+  CodingPlanUsageRequest,
+  CodingPlanUsageSnapshot,
+  ProviderFamilyDomain,
+} from "@zcode/shared";
+import type { LocalCredentialService } from "../credential/credentialService.js";
+import { createCredentialService } from "../credential/credentialService.js";
+import { AccountProviderApiClient } from "../model-provider/accountProviderApiClient.js";
+import { AccountProviderApiKeyResolver } from "../model-provider/accountProviderApiKeyResolver.js";
+import { createAccountProviderCredentialService } from "../model-provider/accountProviderCredentialService.js";
+import { createAccountProviderRequestAuthService } from "../model-provider/accountProviderRequestAuthService.js";
+import { createAccountProjectTokenClient } from "../model-provider/accountProjectTokenClient.js";
+import { OAuthCredentialRepo } from "../oauth/repo/oauthCredentialRepo.js";
+import { setDataBaseDir } from "../paths.js";
+import { createNodeApiClient } from "../providers/api/nodeApiClient.js";
+import { createUsageStatsService } from "../usage-stats/usageStatsService.js";
+
+export interface CostLabBillingRuntimeOptions {
+  readonly dataBaseDir: string;
+  readonly apiClient?: ApiClient;
+  readonly credentialService?: LocalCredentialService;
+  readonly signal?: AbortSignal;
+}
+
+export interface CostLabBillingIdentity {
+  readonly apiKeyId: string | null;
+  readonly accountScope: string | null;
+  readonly organizationId: string | null;
+  readonly projectId: string | null;
+}
+
+export interface CostLabBillingSnapshotResult {
+  readonly snapshot: CodingPlanUsageSnapshot;
+  readonly identity: CostLabBillingIdentity;
+}
+
+type CostLabLocationStoreSource = Pick<LocalCredentialService, "load" | "save" | "delete"> &
+  Partial<Pick<LocalCredentialService, "recoverUnreadable">>;
+
+export type CostLabReadOnlyLocationStore = Pick<
+  LocalCredentialService,
+  "load" | "save" | "delete" | "recoverUnreadable"
+>;
+
+const ACCESS_TOKEN_PATH =
+  /^\/api\/biz\/v1\/organization\/[^/]+\/projects\/[^/]+\/api_keys\/[^/]+\/access_tokens$/;
+const ALLOWED_ORIGINS = new Set([
+  "https://bigmodel.cn",
+  "https://zcode.z.ai",
+  "https://api.z.ai",
+]);
+
+/**
+ * Project token location records are a rebuildable cache. The billing reader
+ * may load one, but must never create, delete, or recover that shared record.
+ */
+export function createCostLabReadOnlyLocationStore(
+  locationStore: CostLabLocationStoreSource,
+): CostLabReadOnlyLocationStore {
+  const rejectWrite = async (): Promise<never> => {
+    throw new Error("cost_lab_read_only_location_store_blocked_write");
+  };
+  return {
+    load: (key) => locationStore.load(key),
+    save: rejectWrite,
+    delete: rejectWrite,
+    recoverUnreadable: rejectWrite,
+  };
+}
+
+/**
+ * Block non-official origins, redirects, and every write except the short-lived
+ * Project Token POST required by the official billing path.
+ */
+export function createCostLabReadOnlyApiClient(
+  apiClient: ApiClient,
+  signal?: AbortSignal,
+): ApiClient {
+  return {
+    async request(input, init) {
+      const url = new URL(typeof input === "string" ? input : input.toString());
+      if (!ALLOWED_ORIGINS.has(url.origin)) {
+        throw new Error("cost_lab_read_only_api_blocked_origin");
+      }
+      const method = (init?.method ?? "GET").toUpperCase();
+      if (method !== "GET") {
+        if (method !== "POST" || !ACCESS_TOKEN_PATH.test(url.pathname)) {
+          throw new Error("cost_lab_read_only_api_blocked_write");
+        }
+      }
+      return apiClient.request(input, {
+        ...init,
+        redirect: "error",
+        ...(signal
+          ? {
+              signal: init?.signal ? AbortSignal.any([init.signal, signal]) : signal,
+            }
+          : {}),
+      });
+    },
+  };
+}
+
+/**
+ * Read-only Cost Lab owner for the official Coding Plan monitor path.
+ *
+ * This composes the same official credential, project-token, request-auth and
+ * usage-stat services as ZCode. It deliberately does not refresh OAuth, start
+ * Desktop services, or expose credential material to the CLI caller.
+ */
+export function createCostLabBillingRuntime(options: CostLabBillingRuntimeOptions) {
+  if (!options.credentialService) setDataBaseDir(options.dataBaseDir);
+  const credentialService =
+    options.credentialService ??
+    createCredentialService({
+      readOnly: true,
+      migrateOnRead: false,
+      readOnlyKeyMaterial: true,
+    });
+  const apiClient = createCostLabReadOnlyApiClient(
+    options.apiClient ?? createNodeApiClient(),
+    options.signal,
+  );
+  const oauthRepo = new OAuthCredentialRepo(credentialService);
+  const loadOAuthAccountMaterial = (family: ProviderFamilyDomain) =>
+    oauthRepo.loadFamilyMaterial(family);
+  const loadOAuthTokenSet = async (providerId: string) => {
+    if (providerId !== "zai" && providerId !== "bigmodel") return null;
+    const account = await loadOAuthAccountMaterial(providerId);
+    return account
+      ? {
+          accessToken: account.accessToken,
+          zcodeJwtToken: account.zcodeJwtToken,
+          sessionRevision: account.sessionRevision,
+          accountIdentity: account.accountIdentity,
+          zcodeUserId: account.zcodeUserId,
+        }
+      : null;
+  };
+  const projectTokenClient = createAccountProjectTokenClient(
+    apiClient,
+    createCostLabReadOnlyLocationStore(credentialService),
+  );
+  const accountProviderApiClient = new AccountProviderApiClient(apiClient);
+  const accountProviderApiKeyResolver = new AccountProviderApiKeyResolver(
+    accountProviderApiClient.fetchRemoteData.bind(accountProviderApiClient),
+    projectTokenClient,
+  );
+  const accountProviderCredentialService = createAccountProviderCredentialService({
+    loadOAuthAccountMaterial,
+    resolveProviderMaterial: (
+      family,
+      accessToken,
+      accountIdentity,
+      rejectedProjectTokenFingerprint,
+    ) =>
+      accountProviderApiKeyResolver.resolveProviderMaterial(
+        family === "zai" ? "zai" : "bigmodel",
+        accessToken,
+        accountIdentity,
+        rejectedProjectTokenFingerprint,
+      ),
+  });
+
+  let identity: CostLabBillingIdentity = Object.freeze({
+    apiKeyId: null,
+    accountScope: null,
+    organizationId: null,
+    projectId: null,
+  });
+  const accountRequestAuthService = createAccountProviderRequestAuthService({
+    resolveCurrentAccountAccess: async () => null,
+    loadOAuthTokenSet,
+    loadStartPlanZcodeJwt: async () => null,
+    async loadIndividualPlanMaterial(providerId, family, rejectedProjectTokenFingerprint) {
+      const accountIdentity = (await loadOAuthAccountMaterial(family))?.accountIdentity;
+      if (!accountIdentity) return null;
+      const material = await accountProviderCredentialService.loadCodingPlanMaterial({
+        providerId,
+        family,
+        accountIdentity,
+        rejectedProjectTokenFingerprint,
+      });
+      if (material) {
+        identity = Object.freeze({
+          apiKeyId: material.apiKeyId,
+          accountScope: null,
+          organizationId: material.organizationId,
+          projectId: material.projectId,
+        });
+      }
+      return material;
+    },
+    resolveTeamPlanMaterial: async () => null,
+  });
+  const observedAccountRequestAuthService = {
+    resolveAccessCurrent: accountRequestAuthService.resolveAccessCurrent.bind(
+      accountRequestAuthService,
+    ),
+    async resolveCurrent(input: Parameters<typeof accountRequestAuthService.resolveCurrent>[0]) {
+      const material = await accountRequestAuthService.resolveCurrent(input);
+      identity = Object.freeze({
+        ...identity,
+        apiKeyId: material.apiKeyId ?? identity.apiKeyId,
+        accountScope: material.accountScope ?? identity.accountScope,
+      });
+      return material;
+    },
+  };
+  const usageStatsService = createUsageStatsService({
+    apiClient,
+    loadOAuthAccountMaterial,
+    accountRequestAuthService: observedAccountRequestAuthService,
+    zcodeAgentService: {
+      getAppUsageStats: async () => {
+        throw new Error("app_usage_not_supported_by_cost_lab_billing_reader");
+      },
+    },
+  });
+
+  return {
+    async getCodingPlanUsageSnapshot(
+      request: CodingPlanUsageRequest,
+    ): Promise<CostLabBillingSnapshotResult> {
+      identity = Object.freeze({
+        apiKeyId: null,
+        accountScope: null,
+        organizationId: null,
+        projectId: null,
+      });
+      const snapshot = await usageStatsService.getCodingPlanUsageSnapshot(request);
+      return { snapshot, identity };
+    },
+  };
+}
