+  type LocalCredentialService,
+} from "../src/credential/credentialService.js";
+import { createOfficialStartPlanAuthenticationResolver } from "../src/official-host/startPlanAuthentication.js";
+import { setDataBaseDir } from "../src/paths.js";
+
+const ROOTS: string[] = [];
+const CREDENTIAL_SECRET = "synthetic-read-only-credential-secret";
+const DEVICE_MID = "synthetic-device-mid";
+const execFileAsync = promisify(execFile);
+
+afterEach(() => {
+  for (const root of ROOTS.splice(0)) rmSync(root, { recursive: true, force: true });
+  setDataBaseDir(null);
+});
+
+function makeDataRoot(): { baseDir: string; dataDir: string; credentialsPath: string } {
+  const baseDir = mkdtempSync(join(tmpdir(), "zcode-start-auth-"));
+  ROOTS.push(baseDir);
+  const dataDir = join(baseDir, ".zcode", "v2");
+  mkdirSync(dataDir, { recursive: true });
+  return { baseDir, dataDir, credentialsPath: join(dataDir, "credentials.json") };
+}
+
+function syntheticJwt(expiresAt: number): string {
+  const encode = (value: unknown): string =>
+    Buffer.from(JSON.stringify(value), "utf8").toString("base64url");
