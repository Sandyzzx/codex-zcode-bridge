@@ -0,0 +1,223 @@
+import type {
+  ApiClient,
+  OAuthProviderId,
+  ProviderFamilyDomain,
+  ZCodeAccountAccess,
+  ZCodeProviderAccountAccess,
+  ZCodeProviderRuntimeHeadersRequestParams,
+  ZCodeProviderRuntimeHeadersResponse,
+} from "@zcode/shared";
+import type { SharedFileLockOptions } from "@zcode/shared/node";
+import { resolveJwtExpiration } from "@zcode/shared";
+import {
+  createCredentialService,
+  type LocalCredentialService,
+} from "../credential/credentialService.js";
+import { createOAuthService } from "../oauth/oauthService.js";
+import {
+  OAuthCredentialRepo,
+  type OAuthAccountMaterial,
+} from "../oauth/repo/oauthCredentialRepo.js";
+import { setDataBaseDir } from "../paths.js";
+import { createNodeApiClient } from "../providers/api/nodeApiClient.js";
+import { AccountProviderApiClient } from "./accountProviderApiClient.js";
+import { AccountProviderApiKeyResolver } from "./accountProviderApiKeyResolver.js";
+import { createAccountProviderCredentialService } from "./accountProviderCredentialService.js";
+import { createAccountProviderRequestAuthService } from "./accountProviderRequestAuthService.js";
+import { createAccountProjectTokenClient } from "./accountProjectTokenClient.js";
+import { resolveAccountTeamPlanRuntimeMaterial } from "./accountProviderTeamPlanRequestKey.js";
+
+const BIGMODEL_PROVIDER_ID = "bigmodel" as const;
+const ZAI_PROVIDER_ID = "zai" as const;
+
+export interface OAuthProviderRuntimeAuthServiceOptions {
+  readonly dataBaseDir: string;
+  readonly credentialService?: LocalCredentialService;
+  readonly apiClient?: ApiClient;
+  readonly oauthService?: Pick<ReturnType<typeof createOAuthService>, "refreshToken">;
+  readonly resolveCurrentAccountAccess: (
+    access: ZCodeProviderAccountAccess,
+  ) => Promise<ZCodeAccountAccess | null>;
+  readonly onProviderLogout?: (
+    provider: OAuthProviderId,
+    accountIdentity?: string | null,
+  ) => Promise<void>;
+  readonly refreshLockOptions?: SharedFileLockOptions;
+  readonly refreshNetworkTimeoutMs?: number;
+}
+
+export interface ResolveProviderRuntimeAuthOptions {
+  readonly signal?: AbortSignal;
+}
+
+export interface OAuthProviderRuntimeAuthService {
+  resolveProviderRuntimeRequest(
+    request: ZCodeProviderRuntimeHeadersRequestParams,
+    options?: ResolveProviderRuntimeAuthOptions,
+  ): Promise<ZCodeProviderRuntimeHeadersResponse>;
+  clearProjectTokenCache(): void;
+}
+
+/**
+ * Minimal host-side composition for `interaction/requestProviderRuntimeHeaders`.
+ *
+ * The factory only composes existing account/OAuth services. It deliberately
+ * does not start Desktop services, create any process or database, or bypass
+ * the credential store selected by `dataBaseDir`.
+ */
+export function createOAuthProviderRuntimeAuthService(
+  options: OAuthProviderRuntimeAuthServiceOptions,
+): OAuthProviderRuntimeAuthService {
+  let credentialService: LocalCredentialService;
+  if (options.credentialService) {
+    credentialService = options.credentialService;
+  } else {
+    setDataBaseDir(options.dataBaseDir);
+    credentialService = createCredentialService();
+  }
+
+  const oauthCredentialRepo = new OAuthCredentialRepo(credentialService);
+  const apiClient = options.apiClient ?? createNodeApiClient();
+  const oauthService =
+    options.oauthService ??
+    createOAuthService(credentialService, {
+      captureCredentialGuard: () => credentialService.captureRecoveryGuard(),
+      apiClient,
+      onProviderLogout: options.onProviderLogout,
+      refreshLockOptions: options.refreshLockOptions,
+      refreshNetworkTimeoutMs: options.refreshNetworkTimeoutMs,
+    });
+
+  const loadOAuthAccountMaterial = (family: ProviderFamilyDomain) =>
+    oauthCredentialRepo.loadFamilyMaterial(family);
+  const loadOAuthFamilyTokenSet = async (providerId: string) => {
+    if (providerId !== ZAI_PROVIDER_ID && providerId !== BIGMODEL_PROVIDER_ID) {
+      return null;
+    }
+    const account = await loadOAuthAccountMaterial(providerId);
+    return account
+      ? {
+          accessToken: account.accessToken,
+          zcodeJwtToken: account.zcodeJwtToken,
+          sessionRevision: account.sessionRevision,
+          accountIdentity: account.accountIdentity,
+          zcodeUserId: account.zcodeUserId,
+        }
+      : null;
+  };
+
+  const projectTokenClient = createAccountProjectTokenClient(apiClient, credentialService);
+  const accountProviderApiClient = new AccountProviderApiClient(apiClient);
+  const accountProviderApiKeyResolver = new AccountProviderApiKeyResolver(
+    accountProviderApiClient.fetchRemoteData.bind(accountProviderApiClient),
+    projectTokenClient,
+  );
+  const accountProviderCredentialService = createAccountProviderCredentialService({
+    loadOAuthAccountMaterial,
+    resolveProviderMaterial: (
+      family,
+      accessToken,
+      accountIdentity,
+      rejectedProjectTokenFingerprint,
+    ) =>
+      accountProviderApiKeyResolver.resolveProviderMaterial(
+        family === "zai" ? ZAI_PROVIDER_ID : BIGMODEL_PROVIDER_ID,
+        accessToken,
+        accountIdentity,
+        rejectedProjectTokenFingerprint,
+      ),
+  });
+
+  const accountRequestAuthService = createAccountProviderRequestAuthService({
+    resolveCurrentAccountAccess: options.resolveCurrentAccountAccess,
+    loadOAuthTokenSet: loadOAuthFamilyTokenSet,
+    async loadIndividualPlanMaterial(providerId, family, rejectedProjectTokenFingerprint) {
+      const accountIdentity = (await loadOAuthAccountMaterial(family))?.accountIdentity;
+      if (!accountIdentity) return null;
+      return accountProviderCredentialService.loadCodingPlanMaterial({
+        providerId,
+        family,
+        accountIdentity,
+        rejectedProjectTokenFingerprint,
+      });
+    },
+    async resolveTeamPlanMaterial(access, rejectedProjectTokenFingerprint) {
+      const accountIdentity = (await loadOAuthAccountMaterial(access.family))?.accountIdentity;
+      if (!accountIdentity) return null;
+      return resolveAccountTeamPlanRuntimeMaterial({
+        apiClient,
+        loadOAuthAccountMaterial,
+        access,
+        accountIdentity,
+        tokenClient: projectTokenClient,
+        rejectedProjectTokenFingerprint,
+      });
+    },
+  });
+
+  return {
+    async resolveProviderRuntimeRequest(request, resolveOptions = {}) {
+      if (resolveOptions.signal?.aborted) {
+        return unavailable();
+      }
+      const accountAccess = request.accountAccess;
+      if (!accountAccess) {
+        return unavailable();
+      }
+      try {
+        if (await needsOAuthRefresh(accountAccess, loadOAuthAccountMaterial)) {
+          const family = accountAccessFamily(accountAccess);
+          const account = await oauthCredentialRepo.loadFamilyMaterial(family);
+          if (!account) return unavailable();
+          await oauthService.refreshToken(account.loginProvider);
+          projectTokenClient.clear();
+        }
+        if (resolveOptions.signal?.aborted) {
+          return unavailable();
+        }
+        const requestAuth = await accountRequestAuthService.resolveCurrent({
+          providerId: request.providerId,
+          modelId: request.modelSelection.modelId,
+          accountAccess,
+          expectedAccountScope: request.expectedAccountScope,
+          rejectedProjectTokenFingerprint: request.rejectedProjectTokenFingerprint,
+          reason: request.reason,
+        });
+        return { headersApplied: true, requestAuth };
+      } catch {
+        return unavailable();
+      }
+    },
+
+    clearProjectTokenCache() {
+      projectTokenClient.clear();
+    },
+  };
+}
+
+function accountAccessFamily(
+  access: ZCodeProviderAccountAccess | ZCodeAccountAccess,
+): ProviderFamilyDomain {
+  return "family" in access ? access.family : access.accountType;
+}
+
+async function needsOAuthRefresh(
+  access: ZCodeProviderAccountAccess | ZCodeAccountAccess,
+  loadOAuthAccountMaterial: (family: ProviderFamilyDomain) => Promise<OAuthAccountMaterial | null>,
+): Promise<boolean> {
+  const account = await loadOAuthAccountMaterial(accountAccessFamily(access));
+  if (!account) return false;
+  const mode = "mode" in access ? access.mode : access.planKind;
+  // Start Plan requests use the main ZCode JWT. Coding/Team Plan requests use
+  // the OAuth access token to obtain a project token. Opaque tokens remain
+  // usable; only a standards-compliant JWT whose exp is due rotates here.
+  const token = mode === "start-plan" ? account.zcodeJwtToken : account.accessToken;
+  return Boolean(token) && resolveJwtExpiration(token).kind === "expired";
+}
+
+function unavailable(): ZCodeProviderRuntimeHeadersResponse {
+  return {
+    headersApplied: false,
+    errorMessage: "Provider request auth is unavailable.",
+  };
+}
