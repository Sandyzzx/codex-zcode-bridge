+++ b/packages/services/src/official-host/startPlanAuthentication.ts
@@ -0,0 +1,141 @@
+import type { ApiClient, ProviderFamilyDomain } from "@zcode/shared";
+import { resolveJwtExpiration } from "@zcode/shared";
+import type { SharedFileLockOptions } from "@zcode/shared/node";
+import {
+  createCredentialService,
+  type LocalCredentialService,
+} from "../credential/credentialService.js";
+import { createOAuthService } from "../oauth/oauthService.js";
+import {
+  OAuthCredentialRepo,
+  type OAuthStartPlanMaterial,
+} from "../oauth/repo/oauthCredentialRepo.js";
+import { setDataBaseDir } from "../paths.js";
+import { createNodeApiClient } from "../providers/api/nodeApiClient.js";
+import { readTelemetryDeviceMid } from "../telemetry/telemetryCore.js";
+
+const START_PLAN_FAMILY: ProviderFamilyDomain = "bigmodel";
+
+export interface OfficialStartPlanAuthentication {
+  readonly accountIdentity: string;
+  readonly sessionRevision: string | null;
+  readonly requestCredential: string;
+  readonly credentialExpiresAt: number | null;
+  readonly deviceMid: string;
+}
+
+export interface ResolveOfficialStartPlanAuthenticationInput {
+  readonly family: "bigmodel";
+  readonly signal: AbortSignal;
+}
+
+export interface OfficialStartPlanAuthenticationResolverOptions {
+  /** Base directory containing `.zcode`; never a Desktop install directory. */
+  readonly dataBaseDir: string;
+  readonly now?: () => number;
+  readonly apiClient?: ApiClient;
+  readonly refreshLockOptions?: SharedFileLockOptions;
+  readonly refreshNetworkTimeoutMs?: number;
+  /** Test-only composition hooks; production constructs official modules. */
+  readonly createReadOnlyCredentialService?: () => LocalCredentialService;
+  readonly createRefreshCredentialService?: () => LocalCredentialService;
+  readonly createOAuthService?: (
+    credentialService: LocalCredentialService,
+    apiClient: ApiClient,
+  ) => Pick<ReturnType<typeof createOAuthService>, "refreshToken">;
+  readonly readDeviceMid?: () => Promise<string | null>;
+}
+
+export interface OfficialStartPlanAuthenticationResolver {
+  resolveStartPlanAuthentication(
+    input: ResolveOfficialStartPlanAuthenticationInput,
+  ): Promise<OfficialStartPlanAuthentication | null>;
+}
+
+/**
+ * Narrow Official Host boundary for Start Plan authentication.
+ *
+ * Credential format, key resolution, account identity and family mapping stay
+ * in the official cipher/repo. The returned object is a one-request projection
+ * and deliberately omits access tokens, refresh tokens, raw records and paths.
+ */
+export function createOfficialStartPlanAuthenticationResolver(
+  options: OfficialStartPlanAuthenticationResolverOptions,
+): OfficialStartPlanAuthenticationResolver {
+  setDataBaseDir(options.dataBaseDir);
+  const now = options.now ?? Date.now;
+  const apiClient = options.apiClient ?? createNodeApiClient();
+  let pendingRefresh: { readonly provider: string; readonly promise: Promise<void> } | null = null;
+
+  const readOnlyCredentialService = (): LocalCredentialService =>
+    options.createReadOnlyCredentialService?.() ??
+    createCredentialService({ readOnly: true });
+
+  const loadMaterial = async (): Promise<OAuthStartPlanMaterial | null> => {
+    const repo = new OAuthCredentialRepo(readOnlyCredentialService());
+    return repo.loadStartPlanMaterial(START_PLAN_FAMILY);
+  };
+
+  const refresh = async (material: OAuthStartPlanMaterial): Promise<void> => {
+    if (pendingRefresh?.provider === material.loginProvider) {
+      await pendingRefresh.promise;
+      return;
+    }
+    const credentialService =
+      options.createRefreshCredentialService?.() ??
+      createCredentialService({
+        migrateOnRead: false,
+        readOnlyKeyMaterial: true,
+      });
+    const oauthService =
+      options.createOAuthService?.(credentialService, apiClient) ??
+      createOAuthService(credentialService, {
+        captureCredentialGuard: () => credentialService.captureRecoveryGuard(),
+        apiClient,
+        refreshLockOptions: options.refreshLockOptions,
+        refreshNetworkTimeoutMs: options.refreshNetworkTimeoutMs,
+      });
+    const promise = oauthService.refreshToken(material.loginProvider);
+    const pending = { provider: material.loginProvider, promise };
+    pendingRefresh = pending;
+    try {
+      await promise;
+    } finally {
+      if (pendingRefresh === pending) pendingRefresh = null;
+    }
+  };
+
+  return {
+    async resolveStartPlanAuthentication(input) {
+      if (input.family !== START_PLAN_FAMILY || input.signal.aborted) return null;
+      try {
+        let material = await loadMaterial();
+        if (!material?.accountIdentity.trim() || !material.zcodeJwtToken?.trim()) return null;
+
+        const initialExpiry = resolveJwtExpiration(material.zcodeJwtToken, now());
+        if (initialExpiry.kind === "expired") {
+          if (input.signal.aborted) return null;
+          await refresh(material);
+          if (input.signal.aborted) return null;
+          material = await loadMaterial();
+        }
+
+        if (!material?.accountIdentity.trim() || !material.zcodeJwtToken?.trim()) return null;
+        const expiration = resolveJwtExpiration(material.zcodeJwtToken, now());
+        if (expiration.kind === "expired") return null;
+        const deviceMid = await (options.readDeviceMid?.() ?? readTelemetryDeviceMid());
+        if (!deviceMid?.trim() || input.signal.aborted) return null;
+
+        return {
+          accountIdentity: material.accountIdentity.trim(),
+          sessionRevision: material.sessionRevision,
+          requestCredential: material.zcodeJwtToken.trim(),
+          credentialExpiresAt: expiration.kind === "unknown" ? null : expiration.expiresAt,
+          deviceMid: deviceMid.trim(),
+        };
+      } catch {
+        return null;
+      }
+    },
+  };
+}
