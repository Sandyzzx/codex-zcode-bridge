        "src/prompts/task-prompt.ts",
        "src/adapters/agent-report.ts",
        "src/adapters/run-outcome.ts",
        "src/manager/normalize.ts"
      ]
    },
    {
      "id": "appserver-adapter",
      "description": "ZCode AppServer adapter, transport framing, provider failures, and failure-facts integration.",
      "paths": [
        "src/adapters/zcode-app-server-adapter.ts",
        "src/runtime/desktop-host-launch.ts",
        "src/runtime/task-timeout.ts",
        "src/runtime/errors.ts",
        "src/diagnostics/failure-facts.ts",
        "src/runtime/start-plan-secret-redactor.ts"
